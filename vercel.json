{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{reader/**,tests/**,eval/**,eval-out/**,arcvisual-media/**,**/__pycache__/**,*.pdf,*.db,*.md}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/cron/sweep", "schedule": "17 6 * * *" }]
}
