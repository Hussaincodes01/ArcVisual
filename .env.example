# Copy to .env for local work. Never commit a filled-in copy.
#
# ============================================================================
#  HOW MANY KEYS DO YOU ACTUALLY NEED?
# ============================================================================
#
#  0 keys — everything runs. `pytest`, `python -m eval.run --no-gate2`, ingest,
#           the heuristic analyzer, codegen, Gate 1, and the reader's landing
#           page. This is not a degraded mode; it is how CI runs.
#
#  1 key  — real explanations. ONE model provider (pick a row below). This is
#           the only key that changes output quality.
#
#  4 keys — full production: model + database + object storage (2: access key
#           id and secret) + a Modal account. Optional on top: Langfuse (2) and
#           Sentry (1) for observability.
#
#  Nothing here is required to see the product work end to end.
# ============================================================================


# ---------------------------------------------------------------------------
# 1. MODEL PROVIDER  — pick ONE. This is the only key that affects quality.
# ---------------------------------------------------------------------------
# auto | anthropic | openrouter | gemini | mistral | deepseek | cerebras | longcontext
#      | groq | poolside | opencode | heuristic
#   auto      first configured of anthropic, a long-context preset, groq, poolside
#             (NOT opencode — see below)
#   heuristic no model at all; deterministic and free. The CI default.
ARCVISUAL_PROVIDER=auto

# --- Option A: Anthropic (recommended) -------------------------------------
# The only backend with all three of: constrained structured output, a prompt
# cache (the paper body is re-read, not re-sent), and exact per-token cost.
# 1 key. Get it at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: route through any Anthropic-compatible gateway (Dedalus Labs, a
# proxy). Same SDK, same model ids — only the host changes. Not a second key.
ANTHROPIC_BASE_URL=

# --- Option A2: Groq (the deployed default: free, fast, constrained JSON) ---
# Free key, no card: console.groq.com/keys. Models are comma-separated fallback
# lists — Groq retires ids without notice, and the provider skips any the server
# reports as gone. Analyze and codegen lead with different models because Groq
# meters tokens per model.
GROQ_API_KEY=
# GROQ_MODEL_CLASSIFY=qwen/qwen3.8-27b,openai/gpt-oss-120b
# GROQ_MODEL_CODEGEN=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Analyze passes over different sections of a long paper (each fits the free tier).
# GROQ_ANALYSIS_PASSES=3

# --- Option A3: a long-context host (recommended over Groq's free tier) -----
# Groq's gpt-oss-120b has a 131K window, but the free tier meters 8,000 tokens a
# minute, so ANALYZE only ever sees ~5,000 characters of the paper. These hosts take
# 100K-260K tokens in ONE request, so the whole paper is analysed in one pass and
# codegen sees a section's full text — which is what lets the model draw the
# mechanism instead of re-typesetting the one equation it happened to be shown.
#
# Pick one with ARCVISUAL_PROVIDER=<preset> and set that preset's key. With
# ARCVISUAL_PROVIDER=auto, the first preset whose key is set is used (after Anthropic).
#
#   preset      key                  default models (comma = fallback chain)        context
#   openrouter  OPENROUTER_API_KEY   qwen/qwen3-235b-a22b-2507, deepseek-v3.2, gpt-oss-120b  131-262K
#   gemini      GEMINI_API_KEY       gemini-flash-latest (AI Studio, free tier)      ~1M (budgeted 262K)
#   mistral     MISTRAL_API_KEY      mistral-medium-latest (free Experiment plan)    131K
#   deepseek    DEEPSEEK_API_KEY     deepseek-v4-flash (paid, very cheap)            131K+
#   cerebras    CEREBRAS_API_KEY     gpt-oss-120b (131K on paid; trial serves less)  131K
#   custom      LLM_API_KEY          any OpenAI-compatible endpoint (LLM_BASE_URL)   LLM_CONTEXT_TOKENS
#
# Model ids are a snapshot — hosts rename and retire them. Check your console and
# override with LLM_MODEL_CLASSIFY / LLM_MODEL_CODEGEN. On OpenRouter, append :free
# to an id for the rate-limited free endpoint (free endpoints may serve less context).
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
# LLM_PRESET=openrouter           # used when ARCVISUAL_PROVIDER=longcontext or auto
# LLM_BASE_URL=                   # custom endpoint, e.g. https://my-vllm.example/v1
# LLM_API_KEY=                    # overrides the preset's own key variable
# LLM_MODEL_CLASSIFY=             # analyze; comma-separated fallback chain
# LLM_MODEL_CODEGEN=              # diagram/parameter filling
# LLM_CONTEXT_TOKENS=131072       # the SMALLEST window in your model chain
# LLM_MAX_TOKENS=16384            # reasoning models bill thinking as output
# LLM_JSON_SCHEMA=1               # 0 = prompt the schema instead of enforcing it
# LLM_REASONING_EFFORT=           # sent as reasoning_effort when set
# LLM_RATE_IN= / LLM_RATE_OUT=    # USD per million tokens; empty = unattributed

# Formula-chain scenes allowed per paper. Past this, transform_chain proposals are
# re-cast as drawn concept diagrams of the same claim.
# ARCVISUAL_MAX_FORMULA_SCENES=2

# --- Option B: Poolside ----------------------------------------------------
# OpenAI-compatible. 1 key, from the Poolside Platform → API Keys tab.
# Trade-offs vs Anthropic: JSON is prompted and validated client-side rather
# than constrained, and there is no prompt cache — so the paper body is re-sent
# on every call, which dominates cost on a multi-scene paper.
POOLSIDE_API_KEY=
POOLSIDE_BASE_URL=https://inference.poolside.ai/v1
POOLSIDE_MODEL_CLASSIFY=poolside/laguna-s-2.1
POOLSIDE_MODEL_CODEGEN=poolside/laguna-s-2.1
POOLSIDE_TEMPERATURE=0.2
# Analyze sends the whole paper (~22k tokens for a 25-section paper) and laguna
# reasons for a long time before answering. Minutes, not seconds.
POOLSIDE_TIMEOUT_S=600
# laguna-s-2.1 is a REASONING model and counts reasoning tokens against max_tokens.
# Measured on arXiv:1706.03762 — at 8192 it spent all 8192 on reasoning and returned
# `content: null` with `finish_reason: "length"`: an HTTP 200 with no answer in it.
# At 32000 it used ~9.8k reasoning and produced a complete result. Do not lower this
# to match another provider's number.
POOLSIDE_MAX_TOKENS=32000
# USD per million tokens, from YOUR contract. Left empty, ArcVisual reports the
# cost as "unattributed" rather than inventing a rate — a $/paper figure that
# quietly excluded unpriced calls would be worse than no figure.
POOLSIDE_RATE_IN=
POOLSIDE_RATE_OUT=

# --- Option C: opencode ----------------------------------------------------
# ZERO keys here — opencode holds its own credentials (`opencode auth login`,
# stored in ~/.local/share/opencode/auth.json). It is an agent CLI, not an
# inference API, so choosing it delegates the MODEL choice to your opencode
# config. It is never auto-selected; set ARCVISUAL_PROVIDER=opencode explicitly.
#
# Cost IS attributed: opencode reports per-step `tokens` and `cost` in its event
# stream, and a `cost: 0` from a free model is a real zero.
#
# `opencode models` lists what your auth actually reaches — check there before
# setting these, because routing differs per account. Verified 2026-08-19:
#   opencode/deepseek-v4-flash       -> 401 "Insufficient balance" (paid Zen)
#   opencode/deepseek-v4-flash-free  -> works
# The same models are also reachable via openrouter/, nvidia/ and opencode-go/.
OPENCODE_BIN=opencode
OPENCODE_MODEL_CLASSIFY=opencode/deepseek-v4-flash-free
OPENCODE_MODEL_CODEGEN=opencode/deepseek-v4-flash-free
OPENCODE_AGENT=
OPENCODE_VARIANT=
# Run `opencode serve` and point this at it, or every call pays a cold start.
# OPENCODE_ATTACH=http://localhost:4096
OPENCODE_ATTACH=
# Note: every call carries ~28k input tokens of opencode's own agent prompt and
# tool definitions before your content. Free on a free model, dominant on a paid one.
OPENCODE_TIMEOUT_S=600


# ---------------------------------------------------------------------------
# 2. PERSISTENCE  — 1 key (a connection string). Needed for the API and to
#    keep articles between runs. The pipeline itself never reads it.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@host/arcvisual


# ---------------------------------------------------------------------------
# 3. OBJECT STORAGE  — 2 keys. Needed only once you are serving rendered video.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arcvisual
# The CDN domain. The bucket itself is PRIVATE — storage.public_url() refuses to
# fall back to an R2 endpoint, because a silent fallback would expose the origin.
R2_PUBLIC_BASE=https://media.arcvisual.example


# ---------------------------------------------------------------------------
# 4. COMPUTE  — no env key. `modal token new` writes ~/.modal.toml.
#    Only needed to render inside a real sandbox; local rendering needs nothing.
# ---------------------------------------------------------------------------
# How scenes reach readers. "client" ships validated parameters and the browser
# animates them (no Manim, no storage — the serverless deployment). "manim" renders
# video. The Vercel entrypoint defaults to client.
# ARCVISUAL_RENDER_MODE=manim
# "stepped" drives jobs through POST /api/jobs/{id}/advance instead of a worker.
# ARCVISUAL_EXECUTION=
# Seconds one advance call may work before returning (Vercel Hobby caps at 300).
# ARCVISUAL_STEP_BUDGET_S=200
# Force the local subprocess renderer. NOT a sandbox — development only.
# ARCVISUAL_RENDERER=local
# Keep N render containers warm; the Manim+TinyTeX image pull is most of the
# wall clock on a cold job.
ARCVISUAL_WARM_RENDERERS=0


# ---------------------------------------------------------------------------
# 5. OBSERVABILITY  — optional, 3 keys total. Nothing breaks without them.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=


# ---------------------------------------------------------------------------
# 6. SECURITY / LIMITS  — no external keys, but change the salt in production.
# ---------------------------------------------------------------------------
# Protects GET /api/cron/sweep; Vercel Cron sends it automatically when set.
CRON_SECRET=
# Salt for hashing submitter IPs. A raw address is never stored; leave this at
# the default and the hashes are guessable.
IP_HASH_SALT=change-me
RATE_LIMIT_PER_HOUR=3
# Fail a stage that writes another stage's Storyboard fields. Leave on: a
# violation should surface in CI, not as a mystery in production.
STRICT_OWNERSHIP=1


# ---------------------------------------------------------------------------
# 7. READER  (reader/.env.local)
# ---------------------------------------------------------------------------
ARCVISUAL_ALLOWED_ORIGINS=http://localhost:3000
# ARCVISUAL_ALLOWED_ORIGIN_REGEX=^https://arcvisual-[a-z0-9]+-team\.vercel\.app$
# ARCVISUAL_API_BASE=http://localhost:8000
# NEXT_PUBLIC_ARCVISUAL_API_BASE=http://localhost:8000
